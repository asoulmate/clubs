# Supabase 프로젝트 설정 (Settings → API 에서 확인)
# 주의: VITE_ 환경변수는 빌드 후 브라우저에 공개된다.
#       service_role 키, DB 비밀번호 등 비밀 정보는 절대 넣지 않는다.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# YouTube Data API v3 키 (채널 영상 목록·자동 매칭용)
# Google Cloud → YouTube Data API v3 사용 설정 후 API 키 발급
# 권장: HTTP referrer를 GitHub Pages / localhost 로 제한
VITE_YOUTUBE_API_KEY=your-youtube-data-api-key

# GitHub Pages 배포 시 하위 경로 (로컬 개발에서는 설정 불필요)
# VITE_BASE_PATH=/morning-star/

# Security/global-rating foundation. Keep every flag OFF until staging gates pass.
VITE_FEATURE_SCOPED_ADMIN_RPC=false
VITE_FEATURE_IDENTITY_CLAIMS=false
VITE_FEATURE_GUEST_CLAIM_CANDIDATES=false
VITE_FEATURE_SHADOW_RATING_CALCULATION=false
VITE_FEATURE_SHADOW_RATING_ADMIN=false
# 글로벌 레이팅 페이지 일반 회원 공개 (기본 OFF — DB assert도 플랫폼 관리자만)
VITE_FEATURE_SHADOW_RATING_PUBLIC=false
